<ContentControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Stn.GuiNext"
    x:Class="Stn.GuiNext.PopupControl"
	x:DataType="local:PopupControl"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
	<ContentControl.Template>
		<ControlTemplate>
			<Grid IsVisible="{TemplateBinding ShowPopup}">
				<Border Background="#000000"
						Opacity="160"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
				<Border CornerRadius="8"
                        BoxShadow="0 4 16 0 #40000000"
                        Width="800"
                        Height="400"
                        Background="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Label Content="{TemplateBinding Title}" Margin="12" FontSize="18" FontWeight="Bold" Grid.Row="0"/>
						<ContentPresenter Grid.Row="1"
							Content="{TemplateBinding Content}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Padding="12"/>
					</Grid>
					
				</Border>
			</Grid>
		</ControlTemplate>
	</ContentControl.Template>
</ContentControl>