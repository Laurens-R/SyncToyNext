<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stn.GuiNext.RemoteConfigurationDialogControl"
			 xmlns:controls="clr-namespace:Stn.GuiNext"
			 xmlns:local="clr-namespace:Stn.GuiNext"
             x:DataType="local:RemoteConfigurationDialogControl">
	<Grid x:Name="mainRemoteConfigGrid" IsVisible="{Binding ShowDialog}">		
		  <controls:PopupControl x:Name="popupDialog" HasOK="True" HasCancel="True" PopupHeight="360" PopupWidth="720" ShowPopup="{Binding ShowDialog}">
			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="22"/>
					<RowDefinition Height="68"/>
					<RowDefinition Height="22"/>
					<RowDefinition Height="48"/>
				</Grid.RowDefinitions>

				<!--Remote path row-->
				<Label FontWeight="Bold" Margin="10 0 0 0 " Grid.Column="0" Grid.Row="0" VerticalAlignment="Bottom">Remote path</Label>
				<StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Top" Margin="0 12 0 0">
					<TextBox x:Name="textboxRemotePath" Margin="14 0 20 0" Height="36" Width="580" HorizontalAlignment="Stretch" Watermark="e.g. a local path (C:\folder) or remote path (\\server\share)"/>
					<Button x:Name="buttonBrowseRemote" Height="36" VerticalContentAlignment="Center">Browse</Button>
				</StackPanel>

				<!--Is compressed row-->
				<Label FontWeight="Bold" Margin="10 0 0 0" Grid.Row="2" VerticalAlignment="Bottom">Is Compressed</Label>
				<StackPanel Orientation="Horizontal" Grid.Row="3" VerticalAlignment="Top" Margin="0 12 0 0">
					<CheckBox x:Name="checkboxIsCompressed" Margin="14 0 0 0"/>
					<Label VerticalAlignment="Center">(only applicable if the remote will be newly provisioned)</Label>
				</StackPanel>
			</Grid>
		</controls:PopupControl>
	</Grid>
</UserControl>
