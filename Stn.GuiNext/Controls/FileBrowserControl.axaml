<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:io="clr-namespace:Stn.Core.IO;assembly=Stn.Core"
             xmlns:local="clr-namespace:Stn.GuiNext"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stn.GuiNext.FileBrowserControl"
             x:DataType="local:FileBrowserControl"
             Background="Transparent">
    <UserControl.Styles>
        <Style Selector="DataGrid">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="14"/>
			<Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>
    <Border Background="#ddd" CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="0">
        <DataGrid 
              x:Name="browserGrid"
              IsReadOnly="True"
              GridLinesVisibility="None"
              ItemsSource="{Binding Entries}"
              BorderThickness="0" 
              BorderBrush="Transparent"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" x:DataType="io:FileBrowserEntry" Binding="{CompiledBinding Name}" Width="400" />
                <DataGridTextColumn Header="Type" x:DataType="io:FileBrowserEntry" Binding="{CompiledBinding Type}" Width="120" />
                <DataGridTextColumn Header="Last Modified" x:DataType="io:FileBrowserEntry" Binding="{CompiledBinding LastModified}" Width="200"  />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</UserControl>
