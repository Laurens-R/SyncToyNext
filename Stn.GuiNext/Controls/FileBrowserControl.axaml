<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:io="clr-namespace:Stn.Core.IO;assembly=Stn.Core"
			 xmlns:local="clr-namespace:Stn.GuiNext"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stn.GuiNext.FileBrowserControl"
			 x:DataType="local:FileBrowserControl"
			 Background="Transparent"
			 >
	<DataGrid 
		  x:Name="browserGrid"
		  Margin="4"
          IsReadOnly="True"
          GridLinesVisibility="None"
	      ItemsSource="{Binding Entries}"
          BorderThickness="1" 
		  BorderBrush="Gray"
		  CanUserResizeColumns="True"
		  CanUserSortColumns="True"
		  >
		<DataGrid.Columns>
			<DataGridTextColumn Header="Name" x:DataType="io:FileBrowserEntry" Binding="{CompiledBinding Name}" Width="400" />
			<DataGridTextColumn Header="Type" x:DataType="io:FileBrowserEntry" Binding="{CompiledBinding Extension}" Width="120" />
			<DataGridTextColumn Header="Last Modified" x:DataType="io:FileBrowserEntry" Binding="{CompiledBinding LastModified}" Width="160"  />
		</DataGrid.Columns>
	</DataGrid>
</UserControl>
