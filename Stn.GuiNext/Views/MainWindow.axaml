<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stn.GuiNext.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Stn.GuiNext.Views"
		xmlns:controls="clr-namespace:Stn.GuiNext"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="Stn.GuiNext.Views.MainWindow"
		x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="STN">
    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#ccc" Offset="0"/>
            <GradientStop Color="#aaa" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
	<Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border BoxShadow="5 0 10 0 #aaa" BorderBrush="#aaa" BorderThickness="1">
				<StackPanel Orientation="Vertical" Margin="20" HorizontalAlignment="Stretch" Grid.Column="0">
					<Border Padding="0 0 0 0" BorderBrush="#666" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
						<Button x:Name="buttonRepository" Background="Transparent" Padding="20" HorizontalContentAlignment="Center"  HorizontalAlignment="Stretch">Repository</Button>
					</Border>
				</StackPanel>
			</Border>

			
			<ContentControl Content="{Binding CurrentView}" Grid.Column="1"/>

			<!--
			<views:RepositoryView Grid.Column="1"/>
			-->

			
		</Grid>
	</Grid>
</Window>
